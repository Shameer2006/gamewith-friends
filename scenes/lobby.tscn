[gd_scene format=3 uid="uid://lobby_scene"]

[ext_resource type="Script" path="res://scripts/lobby.gd" id="1_lobby"]
[ext_resource type="FontFile" path="res://fount/Font1/Ghastly Panic.ttf" id="2_font"]

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_panel"]
bg_color = Color(0.05, 0.03, 0.03, 0.92)
border_width_left = 2
border_width_top = 2
border_width_right = 2
border_width_bottom = 2
border_color = Color(0.30, 0.06, 0.06, 0.85)
corner_radius_top_left = 4
corner_radius_top_right = 4
corner_radius_bottom_right = 4
corner_radius_bottom_left = 4

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_btn"]
bg_color = Color(0.10, 0.04, 0.04, 0.82)
border_width_left = 1
border_width_top = 1
border_width_right = 1
border_width_bottom = 1
border_color = Color(0.40, 0.08, 0.08, 0.75)
corner_radius_top_left = 3
corner_radius_top_right = 3
corner_radius_bottom_right = 3
corner_radius_bottom_left = 3

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_btn_hover"]
bg_color = Color(0.22, 0.05, 0.05, 0.95)
border_width_left = 2
border_width_top = 2
border_width_right = 2
border_width_bottom = 2
border_color = Color(0.65, 0.10, 0.10, 1.0)
corner_radius_top_left = 3
corner_radius_top_right = 3
corner_radius_bottom_right = 3
corner_radius_bottom_left = 3

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_input"]
bg_color = Color(0.08, 0.04, 0.04, 0.90)
border_width_left = 1
border_width_top = 1
border_width_right = 1
border_width_bottom = 1
border_color = Color(0.35, 0.08, 0.08, 0.70)
corner_radius_top_left = 3
corner_radius_top_right = 3
corner_radius_bottom_right = 3
corner_radius_bottom_left = 3

[node name="Lobby" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
script = ExtResource("1_lobby")

[node name="Background" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
color = Color(0.03, 0.02, 0.02, 1.0)
mouse_filter = 2

[node name="CenterContainer" type="CenterContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
mouse_filter = 2

[node name="Panel" type="PanelContainer" parent="CenterContainer"]
custom_minimum_size = Vector2(560, 620)
theme_override_styles/panel = SubResource("StyleBoxFlat_panel")

[node name="VBox" type="VBoxContainer" parent="CenterContainer/Panel"]
layout_mode = 2
theme_override_constants/separation = 14

[node name="TitleLabel" type="Label" parent="CenterContainer/Panel/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.78, 0.10, 0.10, 1.0)
theme_override_fonts/font = ExtResource("2_font")
theme_override_font_sizes/font_size = 42
text = "DUNGEON"
horizontal_alignment = 1

[node name="ModeLabel" type="Label" parent="CenterContainer/Panel/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.60, 0.45, 0.38, 0.90)
theme_override_fonts/font = ExtResource("2_font")
theme_override_font_sizes/font_size = 20
text = "Co-op Survival"
horizontal_alignment = 1

[node name="Divider" type="ColorRect" parent="CenterContainer/Panel/VBox"]
layout_mode = 2
custom_minimum_size = Vector2(0, 2)
mouse_filter = 2
color = Color(0.35, 0.06, 0.06, 0.55)

[node name="HostBtn" type="Button" parent="CenterContainer/Panel/VBox"]
layout_mode = 2
size_flags_horizontal = 4
custom_minimum_size = Vector2(400, 62)
theme_override_colors/font_color = Color(0.88, 0.78, 0.72, 1.0)
theme_override_colors/font_hover_color = Color(1.0, 0.90, 0.85, 1.0)
theme_override_fonts/font = ExtResource("2_font")
theme_override_font_sizes/font_size = 26
theme_override_styles/normal = SubResource("StyleBoxFlat_btn")
theme_override_styles/hover = SubResource("StyleBoxFlat_btn_hover")
theme_override_styles/pressed = SubResource("StyleBoxFlat_btn")
text = "Host Game"

[node name="Divider2" type="ColorRect" parent="CenterContainer/Panel/VBox"]
layout_mode = 2
custom_minimum_size = Vector2(0, 1)
mouse_filter = 2
color = Color(0.25, 0.05, 0.05, 0.35)

[node name="IPBox" type="HBoxContainer" parent="CenterContainer/Panel/VBox"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="IPLabel" type="Label" parent="CenterContainer/Panel/VBox/IPBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.65, 0.50, 0.44, 0.90)
theme_override_fonts/font = ExtResource("2_font")
theme_override_font_sizes/font_size = 20
text = "IP :"
vertical_alignment = 1

[node name="IPInput" type="LineEdit" parent="CenterContainer/Panel/VBox/IPBox"]
layout_mode = 2
size_flags_horizontal = 3
custom_minimum_size = Vector2(260, 46)
theme_override_colors/font_color = Color(0.88, 0.78, 0.72, 1.0)
theme_override_colors/caret_color = Color(0.80, 0.20, 0.20, 1.0)
theme_override_fonts/font = ExtResource("2_font")
theme_override_font_sizes/font_size = 18
theme_override_styles/normal = SubResource("StyleBoxFlat_input")
theme_override_styles/focus = SubResource("StyleBoxFlat_input")
placeholder_text = "127.0.0.1"
text = "127.0.0.1"

[node name="JoinBtn" type="Button" parent="CenterContainer/Panel/VBox"]
layout_mode = 2
size_flags_horizontal = 4
custom_minimum_size = Vector2(400, 62)
theme_override_colors/font_color = Color(0.72, 0.88, 0.68, 1.0)
theme_override_colors/font_hover_color = Color(0.88, 1.0, 0.84, 1.0)
theme_override_fonts/font = ExtResource("2_font")
theme_override_font_sizes/font_size = 26
theme_override_styles/normal = SubResource("StyleBoxFlat_btn")
theme_override_styles/hover = SubResource("StyleBoxFlat_btn_hover")
theme_override_styles/pressed = SubResource("StyleBoxFlat_btn")
text = "Join Game"

[node name="StatusLabel" type="Label" parent="CenterContainer/Panel/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.55, 0.45, 0.40, 0.80)
theme_override_fonts/font = ExtResource("2_font")
theme_override_font_sizes/font_size = 16
text = ""
horizontal_alignment = 1

[node name="PlayerListLabel" type="Label" parent="CenterContainer/Panel/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.45, 0.35, 0.30, 0.70)
theme_override_fonts/font = ExtResource("2_font")
theme_override_font_sizes/font_size = 14
text = "Waiting for players..."
horizontal_alignment = 1

[node name="StartBtn" type="Button" parent="CenterContainer/Panel/VBox"]
layout_mode = 2
size_flags_horizontal = 4
custom_minimum_size = Vector2(400, 62)
visible = false
theme_override_colors/font_color = Color(0.88, 0.78, 0.72, 1.0)
theme_override_colors/font_hover_color = Color(1.0, 0.90, 0.85, 1.0)
theme_override_fonts/font = ExtResource("2_font")
theme_override_font_sizes/font_size = 26
theme_override_styles/normal = SubResource("StyleBoxFlat_btn")
theme_override_styles/hover = SubResource("StyleBoxFlat_btn_hover")
theme_override_styles/pressed = SubResource("StyleBoxFlat_btn")
text = "Begin"

[node name="BackBtn" type="Button" parent="CenterContainer/Panel/VBox"]
layout_mode = 2
size_flags_horizontal = 4
custom_minimum_size = Vector2(400, 50)
theme_override_colors/font_color = Color(0.55, 0.42, 0.38, 0.85)
theme_override_colors/font_hover_color = Color(0.75, 0.60, 0.55, 1.0)
theme_override_fonts/font = ExtResource("2_font")
theme_override_font_sizes/font_size = 20
theme_override_styles/normal = SubResource("StyleBoxFlat_btn")
theme_override_styles/hover = SubResource("StyleBoxFlat_btn_hover")
theme_override_styles/pressed = SubResource("StyleBoxFlat_btn")
text = "Back"

[connection signal="pressed" from="CenterContainer/Panel/VBox/HostBtn" to="." method="_on_host_pressed"]
[connection signal="pressed" from="CenterContainer/Panel/VBox/JoinBtn" to="." method="_on_join_pressed"]
[connection signal="pressed" from="CenterContainer/Panel/VBox/StartBtn" to="." method="_on_start_pressed"]
[connection signal="pressed" from="CenterContainer/Panel/VBox/BackBtn" to="." method="_on_back_pressed"]
